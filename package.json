{
  "name": "outlook-chrome-extension",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "sync:version": "node scripts/sync-version.js",
    "lint": "eslint --rulesdir .eslint-rules \"**/*.js\"",
    "lint:webext": "node scripts/run-webext-lint.js",
    "check:release-version": "node scripts/check-release-version.js --require-bump",
    "test:search": "node --test tests/search-filter.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test tests/search-filter.test.js"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sonarjs": "^0.25.0",
    "eslint-plugin-unicorn": "^50.0.0",
    "node-fetch": "2.6.11",
    "web-ext": "^7.11.0"
  }
}
